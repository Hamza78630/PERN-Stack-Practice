NODE_ENV=development
PORT=3002
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Must be at least 32 characters long.
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=techsolve
PG_PASSWORD=techsolve
PG_DATABASE=techsolve

# --- Redis (caching + BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email (SMTP) ---
# Defaults match the mailhog service in docker-compose.yml — visit
# http://localhost:8025 to see emails sent in local development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TechSolve <no-reply@techsolve.dev>"
